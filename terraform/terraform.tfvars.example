# AWS Configuration
aws_region = "us-east-1"

# Application Configuration
app_name    = "ai-readiness-diagnostic"
environment = "production"

# Docker Image (set this to your ECR repository after first deployment)
# Format: <account-id>.dkr.ecr.<region>.amazonaws.com/<repo-name>:<tag>
container_image = "023138541872.dkr.ecr.us-east-1.amazonaws.com/ai-readiness-diagnostic:latest"

# Container Port
container_port = 8080

# ECS Task Configuration
task_cpu    = 1024
task_memory = 2048

# ECS Service Configuration
desired_count = 1

# Auto Scaling (optional)
enable_autoscaling = false
min_capacity       = 1
max_capacity       = 3

# VPC and Subnets (optional - uses default VPC/subnets if not provided)
# If you have IAM permission issues, provide these explicitly:
# vpc_id    = "vpc-12345678"
# subnet_ids = ["subnet-11111111", "subnet-22222222"]

# Outbound mail (Amazon SES)
# The address is verified as an e-mail identity: applying sends a verification link to
# this mailbox, and sends fail until someone opens it. In the SES sandbox the recipient
# must be a verified identity too.
mail_from_address = "catalystx-support@dxc.com"
mail_from_name    = "DXC AI Readiness"
# mail_reply_to_address = "a-monitored-mailbox@dxc.com"

# Test recipients, verified so a sandboxed account can send to them. Each owner gets a
# verification mail they must open. Set these in your own terraform.tfvars, which is
# gitignored — these are real mailboxes and do not belong in a tracked file. Use one
# internal and one external address, since they exercise different delivery paths.
# Remove once the account leaves the SES sandbox.
# test_recipient_addresses = [
#   "you@dxc.com",
#   "your-external-test@example.com",
# ]

# Bedrock API Key and Endpoint (REQUIRED for LLM to work)
# 1. Go to AWS Console → Bedrock → API keys
# 2. Create a new API key
# 3. Copy the key and set it below
# anthropic_api_key = "your-bedrock-api-key-here"
# anthropic_base_url = "https://bedrock-mantle.us-east-1.api.aws/anthropic"

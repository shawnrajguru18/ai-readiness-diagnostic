# Copy to .env and fill in. Never commit .env.

# AWS Bedrock (generate API key in AWS Console → Bedrock → API keys)
ANTHROPIC_API_KEY=your-bedrock-api-key-here
ANTHROPIC_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/anthropic
AWS_REGION=us-east-1

# ElevenLabs (voice interview path — Week 2; chat works without it)
ELEVENLABS_API_KEY=

# Optional model overrides (defaults to claude-opus-4-8 for all agents).
# Switch high-frequency, low-stakes agents to a faster model only if you choose to:
# AIDIAG_MODEL_DEFAULT=claude-opus-4-8
# AIDIAG_MODEL_QUESTIONER=claude-haiku-4-5
# AIDIAG_MODEL_CAPTURE=claude-haiku-4-5
# AIDIAG_MODEL_SCORING=claude-opus-4-8

# Effort for the heavier reasoning agents (scoring/probe/planner): low|medium|high|max
# AIDIAG_EFFORT=high

# Research toggles
# AIDIAG_ENABLE_RESEARCH=true
# AIDIAG_SEC_USER_AGENT=DXC AdvisoryX Diagnostic contact@dxc.com
